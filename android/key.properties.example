# Copy this file to android/key.properties and fill in your release keystore
# details to produce a signed release build. This file is git-ignored.
#
# Generate a keystore with:
#   keytool -genkey -v -keystore ~/app-cloner-release.jks \
#     -keyalg RSA -keysize 2048 -validity 10000 -alias upload
#
storeFile=/absolute/path/to/app-cloner-release.jks
storePassword=YOUR_STORE_PASSWORD
keyAlias=upload
keyPassword=YOUR_KEY_PASSWORD
